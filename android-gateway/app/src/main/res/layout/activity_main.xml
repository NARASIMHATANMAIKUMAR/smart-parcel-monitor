<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- App Title & Parcel ID Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_dark"
                app:strokeColor="@color/border_glass"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_box"
                            app:tint="@color/accent_cyan" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/title_parcel_monitor"
                            android:textColor="@color/text_white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monitored Parcel ID:"
                            android:textColor="@color/text_gray"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etParcelId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@android:color/transparent"
                            android:inputType="textCapCharacters"
                            android:text="PARCEL-001"
                            android:textColor="@color/accent_cyan"
                            android:textStyle="bold"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dashboard Host IP:"
                            android:textColor="@color/text_gray"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/etServerHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@android:color/transparent"
                            android:inputType="textUri"
                            android:text="10.12.232.153:8080"
                            android:textColor="@color/accent_cyan"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Status Chips Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_dark"
                app:strokeColor="@color/border_glass"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SYSTEM STATUS &amp; CONNECTIVITY"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- Status Items -->
                    <TextView
                        android:id="@+id/tvStatusBt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/status_bt_disconnected"
                        android:textColor="@color/state_red"
                        android:textSize="14sp"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_bluetooth"
                        app:drawableTint="@color/state_red"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvStatusSensor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sensor Data: Awaiting stream"
                        android:textColor="@color/text_gray"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvStatusNetwork"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/status_net_offline"
                        android:textColor="@color/text_gray"
                        android:textSize="14sp"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_cloud"
                        app:drawableTint="@color/text_gray"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvStatusGps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/status_gps_no_fix"
                        android:textColor="@color/state_yellow"
                        android:textSize="14sp"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_gps"
                        app:drawableTint="@color/state_yellow"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvStatusUpload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cloud Sync: Standby"
                        android:textColor="@color/text_gray"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Control Actions Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_dark"
                app:strokeColor="@color/border_glass"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConnectBt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_connect_bt"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/accent_cyan"
                            android:textColor="@color/primary_dark" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDisconnectBt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/btn_disconnect_bt"
                            android:textAllCaps="false"
                            android:visibility="gone"
                            app:backgroundTint="@color/state_red"
                            android:textColor="@color/text_white" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleMonitoring"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_start_monitoring"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/state_green"
                        android:textColor="@color/text_white" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchLocationSharing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="@string/label_location_sharing"
                        android:textColor="@color/text_white" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Condition Telemetry Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_dark"
                app:strokeColor="@color/border_glass"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PARCEL PHYSICAL CONDITION"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvConditionState"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SECURE"
                            android:textColor="@color/state_green"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOpenCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Opens: 0"
                            android:textColor="@color/text_white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvShakeLevel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Shock: LOW"
                            android:textColor="@color/text_white"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvAccelAxes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AX: 0  AY: 0  AZ: 16384"
                            android:textColor="@color/text_gray"
                            android:fontFamily="monospace"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGpsCoords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Proxy GPS: Lat: --, Lon: -- (Acc: --)"
                        android:textColor="@color/accent_cyan"
                        android:fontFamily="monospace"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvLastUploadTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Last Cloud Upload: None"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Live Transit Location Map Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_dark"
                app:strokeColor="@color/border_glass"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TRANSIT MAP (PROXY GPS)"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenGoogleMaps"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Google Maps"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/accent_cyan"
                            android:textColor="@color/primary_dark" />

                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <WebView
                            android:id="@+id/mapWebView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Raw Firmware Diagnostics Console Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardBackgroundColor="@color/console_black"
                app:strokeColor="@color/border_glass"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_raw_diagnostics"
                            android:textColor="@color/accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnClearConsole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:padding="4dp" />

                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/svConsole"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/tvConsoleLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="[Diagnostic Console Ready]\nAwaiting connection to HC-05 at 9600 baud...\n"
                            android:textColor="#34D399"
                            android:textSize="11sp" />

                    </ScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
